#!/usr/bin/expect -f
set timeout 10
log_user 0

if {![info exists env(TEST_BASHRC)]} {
    puts stderr "TEST_BASHRC is required"
    exit 1
}
if {![info exists env(TEST_COMPLETION_DIR)]} {
    puts stderr "TEST_COMPLETION_DIR is required"
    exit 1
}

proc wait_for {text} {
    expect {
        -exact $text { return }
        timeout {
            puts stderr "timed out waiting for: $text"
            exit 1
        }
        eof {
            puts stderr "interactive Bash exited while waiting for: $text"
            exit 1
        }
    }
}

set env(HISTFILE) /dev/null
# GitHub's macOS image does not install Ghostty's terminfo entry. The key
# decoder is terminal-independent, so use the universally available entry.
set env(TERM) xterm-256color
set env(PS1) "GMK-TEST> "
set stty_init "rows 24 columns 80"
spawn /bin/bash --noprofile --rcfile $env(TEST_BASHRC) -i

# Wait until ble.sh has finished terminal detection and is actually reading a
# command. Fixed sleeps are unreliable on slower CI runners.
wait_for "GMK-TEST> "

# Readline-style completion lists are plain text. ble.sh's filename faces use
# SGR 4 by default, so catch the exact underline sequence seen by users.
send -- {printf "<COMPLETION-COLOR:%s,%s>\n" "$bleopt_complete_menu_color" "$bleopt_complete_menu_color_match"}
send -- "\r"
expect {
    -re {<COMPLETION-COLOR:([^,]*),([^>]*)>} {
        if {$expect_out(1,string) ne "" || $expect_out(2,string) ne ""} {
            puts stderr "completion candidate coloring is enabled"
            exit 1
        }
    }
    timeout {
        puts stderr "timed out reading completion color options"
        exit 1
    }
    eof {
        puts stderr "interactive Bash exited during completion color check"
        exit 1
    }
}
wait_for "GMK-TEST> "
send -- "cd -- $env(TEST_COMPLETION_DIR)\r"
wait_for "GMK-TEST> "
send -- "cat "
after 100
send -- "\t"
after 100
send -- "\t"
after 500
send -- "\003"
expect {
    -exact "GMK-TEST> " { set completion_output $expect_out(buffer) }
    timeout {
        puts stderr "timed out waiting for prompt after completion"
        exit 1
    }
    eof {
        puts stderr "interactive Bash exited during completion test"
        exit 1
    }
}
set underline_sgr [binary format H* 1b5b303b34]
if {[string first $underline_sgr $completion_output] >= 0} {
    puts stderr "completion candidates are underlined"
    exit 1
}

# Shift+Left twice must retain one selection anchor. Backspace then removes CD.
send -- "printf '<SHIFT:%s>\\n' ABCD\033\[1;2D\033\[1;2D"
send -- "\177\r"
wait_for "<SHIFT:AB>"
wait_for "GMK-TEST> "

# Kitty CSI-u encoding for Command+A, followed by Backspace.
send -- "discard this\033\[97;9u"
send -- "\177printf '<COMMAND-A>\\n'\r"
wait_for "<COMMAND-A>"
wait_for "GMK-TEST> "

# The normal macOS Option+Backspace sequence removes the previous word.
send -- "printf '<OPTION:%s>\\n' one two\033\177\r"
wait_for "<OPTION:one>"
wait_for "GMK-TEST> "

# Option+Shift+Left selects OLD; bracketed paste must replace the selection.
send -- "printf '<PASTE:%s>\\n' OLD\033\[1;4D\033\[200~NEW\033\[201~\r"
wait_for "<PASTE:NEW>"
wait_for "GMK-TEST> "

# Command+Z removes the inserted command, and Command+Shift+Z restores it.
send -- "printf '<REDO>\\n'"
after 100
send -- "\033\[122;9u"
after 100
send -- "\033\[122;10u\r"
wait_for "<REDO>"
wait_for "GMK-TEST> "

send -- "exit\r"
expect eof
puts "keybinding behavior test passed"
